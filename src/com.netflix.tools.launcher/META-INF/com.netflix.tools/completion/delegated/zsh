@FUNCTION@() {
    local current="${words[CURRENT]}"
    local -a arguments values displays
    if (( CURRENT > 2 )); then
        arguments=("${words[@]:1:$((CURRENT - 2))}")
    fi
    local value description
    while IFS=$'\t' read -r value description; do
        [[ "$value" == :* ]] && continue
        values+=("$value")
        if [[ -n "$description" ]]; then
            displays+=("$value -- $description")
        else
            displays+=("$value")
        fi
    done < <(command @COMMAND@ __complete "${arguments[@]}" "$current" 2>/dev/null)
    compadd -d displays -- "${values[@]}"
}
compdef @FUNCTION@ @COMMAND@
